# Copy this file to .env for local development.
# Do not commit .env because it contains secrets.
# Use KEY=value format without quotes.

# Supabase Postgres connection string.
# Use the pooler/session connection string if Supabase gives multiple options.
# Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Cloudinary credentials.
# Dashboard: Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder prefix for saved dataset assets on Cloudinary.
CLOUDINARY_FOLDER=lowlight_datasets

# Delete Render/local temporary upload/frame/job files after saving reviewed pairs.
# Recommended true for Render free because there is no persistent disk.
CLEANUP_AFTER_SAVE=true

# App/team objective shown in the UI is currently configured in web_platform/app.py:
# TEAM_OBJECTIVE_PAIRS = 500
